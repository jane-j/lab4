  545  00001684          	_Open:
  546                      ;;; Note that trap #0x213 actually causes a trap vector in the OS of
  547                      ;;; 0x1213.  The same is true for other user traps.  Thus, a user trap
  548                      ;;; with trap #0x240 will result in a trap vector of 0x1240 in the OS.
  549  00001684  44000213	trap	#0x213
  550  00001688  4be00000	jr	r31
  551  0000168c  54000000	nop
  552  00001690          	.endproc _Open
