  527                      ;;; Stub functions for DLX traps.
  528                      ;;;
  529                      ;;; Ethan L. Miller, 1999.  Released to the public domain.
  530                      ;;;
  531                      ;;; The traps such as Open and Close
  532                      ;;; (note the capital letters) are for use by user programs.  The traps
  533                      ;;; with names such as open and close (lower case) are for use by the OS.
  534                      ;;;
  536  0000d11c          	.text
  537  00001684          	.align 2
