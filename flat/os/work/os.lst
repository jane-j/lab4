24971                      ;;;
24972                      ;;; Stub functions for DLX traps.
24973                      ;;;
24974                      ;;; Ethan L. Miller, 1999.  Released to the public domain.
24975                      ;;;
24976                      ;;; There are two exit traps.  The first, _exitsim, actually exits the
24977                      ;;; simulator.  The second, _exit, simply calls a regular trap in the
24978                      ;;; DLX simulator, and would be suitable for a user program that wants
24979                      ;;; to signal the OS that it's exiting.
24980                      ;;;
24981                      ;;; IMPORTANT: all code that's run "native" on the simulator - OS code and
24982                      ;;; programs run without an OS - should call exitsim() rather than just
24983                      ;;; falling through to exit.
24984                      ;;;
24987  00015bec          	.align 2
24988  00015bec          	.proc _exitsim
24989  00015bec          	.global _exitsim
24990  00015bec          	_exitsim:
24991  00015bec  44002f00	trap	#0x2f00
24992  00015bf0  4be00000	jr	r31
24993  00015bf4  54000000	nop
24994  00015bf8          	.endproc _exitsim
24996  00015bf8          	.proc _exit
24997  00015bf8          	.global _exit
24998  00015bf8          	_exit:
24999  00015bf8  44000300	trap	#0x300
25000  00015bfc  4be00000	jr	r31
25001  00015c00  54000000	nop
25002  00015c04          	.endproc _exit
