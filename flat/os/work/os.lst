20468  000120c8          	.align 2
20470                      ;;;----------------------------------------------------------------------
20471                      ;;; osinit
20472                      ;;;
20473                      ;;; This is the first function called by the simulator, even before main.
20474                      ;;; Since it's called BEFORE any "real" routines, we can use any registers
20475                      ;;; we want as long as we don't mess up the stack or frame pointers.
20476                      ;;;
20477                      ;;; This routine loads the interrupt vector to point to the interrupt
20478                      ;;; handler later in this file.  It should never return, because _main
20479                      ;;; should call exitsim() or exit() rather than returning here.
20480                      ;;; 
20481                      ;;; After initialization is done, this routine jumps to _main to start the
20482                      ;;; C code portion of the operating system.
20483                      ;;;----------------------------------------------------------------------
20484  000120c8          	.proc _osinit
20485  000120c8          	.global _osinit
20486  000120c8          	_osinit:
20487                      ;; Set up the interrupt handler
20488  000120c8  3c010001	lhi	r1,(_intrhandler>>16)&0xffff
20489  000120cc  242120d8	addui	r1,r1,_intrhandler&0xffff
20490  000120d0  00204030	movi2s	intrvec,r1
20491                      ;; Never returns because exitsim is called first
20492  000120d4  0bff67f8	j	_main
20493  000120d8          	.endproc _osinit
20495                      ;;;----------------------------------------------------------------------
20496                      ;;; intrhandler
20497                      ;;;
20498                      ;;; Called when an interrupt or trap is received by the CPU.  It stores the
20499                      ;;; current register set on the system stack.  It then pushes the parameters
20500                      ;;; to the C interrupt handler onto the stack: the ISR, IAR, and CAUSE
20501                      ;;; registers along with the original stack pointer.  The C interrupt
20502                      ;;; handler can then copy arguments from the original stack, performing
20503                      ;;; user -> system translations if necessary.
20504                      ;;; 
20505                      ;;;----------------------------------------------------------------------
20506  000120d8          	.proc _intrhandler
20507  000120d8          	.global _intrhandler
20508  000120d8          	_intrhandler:
20509                      ;; We can use r31 as scratch space because its value was saved in
20510                      ;; ir31.  However, we must save the "real" value of r31 on the
20511                      ;; stack.
20513                      ;; Always store the registers on the system stack.  This way, we don't
20514                      ;; have to worry about translating things from user -> system.  We
20515                      ;; use r31 as the base register because its value was saved in ir31.
20517                      ;; If this was a user process, load r29 with the current system
20518                      ;; stack pointer.  If it was a system process, just use the
20519                      ;; current stack pointer.
20520  000120d8  0060f831	movs2i	r31,isr
20521  000120dc  33ff0040	andi	r31,r31,0x40
20522  000120e0  17e0001c	bnez	r31,intrSystem_LF14
20523  000120e4  3c1f0001	lhi	r31,(_currentPCB>>16)&0xffff
20524  000120e8  27ffb370	addui	r31,r31,_currentPCB&0xffff
20525  000120ec  8fff0000	lw	r31,(r31)
20526  000120f0  8fff0004	lw	r31,4(r31)
20527                      ;; Save the original (user) stack pointer
20528  000120f4  affdff48	sw	-184(r31),r29; we haven't yet bumped SP, and 156-340 = -184
20529                      ;; Copy the system stack pointer into r29 (current stack pointer)
20530  000120f8  37fd0000	ori	r29,r31,0
20531  000120fc  10000004	beqz	r0,intrSaveReg_LF14; skip over the system part....
20532  00012100          	intrSystem_LF14:
20533                      ;; Use the stack pointer we're already using
20534                      ;; Save r29 because we won't save it later
20535  00012100  afbdff48	sw	-184(r29),r29; we haven't yet bumped SP, and 156-340 = -184
20536  00012104          	intrSaveReg_LF14:
20537                      ;; Adjust stack pointer for all the stuff we're going to push.  This
20538                      ;; is a bit more space than we need currently, but it leaves room
20539                      ;; for more stuff if needed.
20540  00012104  2fbd0154	subui	r29,r29,#340
20541                      ;; Push all the stuff onto the stack
20542  00012108  afa1002c	sw	44(r29),r1
20543  0001210c  afa20030	sw	48(r29),r2
20544  00012110  afa30034	sw	52(r29),r3
20545  00012114  afa40038	sw	56(r29),r4
20546  00012118  afa5003c	sw	60(r29),r5
20547  0001211c  afa60040	sw	64(r29),r6
20548  00012120  afa70044	sw	68(r29),r7
20549  00012124  afa80048	sw	72(r29),r8
20550  00012128  afa9004c	sw	76(r29),r9
20551  0001212c  afaa0050	sw	80(r29),r10
20552  00012130  afab0054	sw	84(r29),r11
20553  00012134  afac0058	sw	88(r29),r12
20554  00012138  afad005c	sw	92(r29),r13
20555  0001213c  afae0060	sw	96(r29),r14
20556  00012140  afaf0064	sw	100(r29),r15
20557  00012144  afb00068	sw	104(r29),r16
20558  00012148  afb1006c	sw	108(r29),r17
20559  0001214c  afb20070	sw	112(r29),r18
20560  00012150  afb30074	sw	116(r29),r19
20561  00012154  afb40078	sw	120(r29),r20
20562  00012158  afb5007c	sw	124(r29),r21
20563  0001215c  afb60080	sw	128(r29),r22
20564  00012160  afb70084	sw	132(r29),r23
20565  00012164  afb80088	sw	136(r29),r24
20566  00012168  afb9008c	sw	140(r29),r25
20567  0001216c  afba0090	sw	144(r29),r26
20568  00012170  afbb0094	sw	148(r29),r27
20569  00012174  afbc0098	sw	152(r29),r28
20570                      ;; Skip r29 - stored earlier!
20571  00012178  afbe00a0	sw	160(r29),r30
20572                      ;; Load the value of r31 from the special register and then save it
20573  0001217c  00401831	movs2i	r3,ir31
20574  00012180  afa300a4	sw	164(r29),r3
20575                      ;; Store the floating-point registers
20576  00012184  bfa000a8	sd	168(r29),f0
20577  00012188  bfa200b0	sd	176(r29),f2
20578  0001218c  bfa400b8	sd	184(r29),f4
20579  00012190  bfa600c0	sd	192(r29),f6
20580  00012194  bfa800c8	sd	200(r29),f8
20581  00012198  bfaa00d0	sd	208(r29),f10
20582  0001219c  bfac00d8	sd	216(r29),f12
20583  000121a0  bfae00e0	sd	224(r29),f14
20584  000121a4  bfb000e8	sd	232(r29),f16
20585  000121a8  bfb200f0	sd	240(r29),f18
20586  000121ac  bfb400f8	sd	248(r29),f20
20587  000121b0  bfb60100	sd	256(r29),f22
20588  000121b4  bfb80108	sd	264(r29),f24
20589  000121b8  bfba0110	sd	272(r29),f26
20590  000121bc  bfbc0118	sd	280(r29),f28
20591  000121c0  bfbe0120	sd	288(r29),f30
20592                      ;; NOTE: we don't save the interrupt vector register because it
20593                      ;; doesn't change from process to process.
20594                      ;; NOTE: we don't save the status register because most of the flags
20595                      ;; are the same from process to process if they're in the interrupt
20596                      ;; handler.  Of course, we DO save the ISR.
20597  000121c4  00802031	movs2i	r4,iar
20598  000121c8  afa40128	sw	296(r29),r4
20599  000121cc  00602831	movs2i	r5,isr
